# Streamlit Cloud Dashboard Configuration - Example
# Save as .streamlit/secrets.toml in Streamlit Cloud dashboard

# ============================================
# FIREBASE CONFIGURATION
# ============================================
# Obtain these from Firebase Console:
# 1. Go to Firebase Console → Your Project → Project Settings
# 2. Click "Service Accounts" tab
# 3. Click "Generate new private key" → a JSON file downloads
# 4. Copy the contents below (replace with your actual values)

[firebase]
type = "service_account"
project_id = "your-firebase-project-id"
private_key_id = "your-private-key-id"
private_key = "-----BEGIN PRIVATE KEY-----\nMIIEvQIBADANBgkqhkiG9w0BAQE...\n-----END PRIVATE KEY-----\n"
client_email = "firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com"
client_id = "123456789"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "https://www.googleapis.com/certificates/..."

# ============================================
# STREAMLIT CONFIGURATION (Optional)
# ============================================
# Set this in Streamlit Cloud UI:
# Settings → Advanced Settings → Secrets
# OR paste the entire content above directly
