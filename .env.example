# Backend Configuration
# Copy this file to .env and set your values

# FastAPI Server
HOST=0.0.0.0
PORT=8000
RELOAD=true

# ML Pipeline Mode
# true = use fast heuristic scoring (no GPU/model required)
# false = use neural network model (requires GPU or CPU, slower)
USE_HEURISTIC_PIPELINE=false

# Audio/Video Processing
CHUNK_WINDOW_SECONDS=5
USE_LOCAL_TRANSCRIBER=false

# Streamlit Frontend Configuration
# Point Streamlit to this backend API URL
STREAMLIT_API_URL=http://localhost:8000

# ngrok Configuration (for public exposure)
# NGROK_AUTHTOKEN=your_auth_token_here
# To generate: https://dashboard.ngrok.com/auth/your-authtoken

# Optional: API Keys or External Services
# OPENAI_API_KEY=your_key_here
# SPEECH_API_KEY=your_key_here
