# Edge Camera Runner Configuration - Example
# Set these environment variables to customize the camera runner

# ============================================
# CAMERA SOURCE
# ============================================
# 0 = Default webcam
# "rtsp://username:password@192.168.1.100:554/stream1" = IP CCTV
# "/dev/video0" = Linux camera device
# "nvarguscamerasrc" = Jetson Nano camera
EDGE_CAMERA_URL=0

# ============================================
# BACKEND API
# ============================================
# URL of the local FastAPI backend
# 127.0.0.1 = localhost (if running on same machine)
# 192.168.1.100:8000 = if backend is on another machine on LAN
EDGE_BACKEND_URL=http://127.0.0.1:8000/evaluate

# ============================================
# RECORDING SETTINGS
# ============================================
# Duration of each recording clip in seconds
EDGE_RECORD_DURATION=30

# Waiting time between consecutive captures in seconds
EDGE_CAPTURE_INTERVAL=10

# Output directory for recorded clips
EDGE_OUTPUT_DIR=outputs/batch_input

# ============================================
# PERFORMANCE TUNING
# ============================================
# Skip preview window (useful for headless servers)
# EDGE_SKIP_PREVIEW=true

# Set video codec: mp4v, H264, MJPEG
# EDGE_VIDEO_CODEC=mp4v
